{
    "name": "statamic-addon/component-exporter",
    "description": "Export and import page sections — fieldsets, partials, baked Tailwind and previews travel together — as a ZIP, from the Control Panel",
    "type": "statamic-addon",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "statamic/cms": "^6.0",
        "statamic-addon/visual-editor": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "Vizuall\\ComponentExporter\\": "src/"
        }
    },
    "extra": {
        "statamic": {
            "name": "Component Exporter",
            "provider": "Vizuall\\ComponentExporter\\AddonServiceProvider"
        },
        "laravel": {
            "providers": [
                "Vizuall\\ComponentExporter\\AddonServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "orchestra/testbench": "^10.8"
    },
    "autoload-dev": {
        "psr-4": {
            "Vizuall\\ComponentExporter\\Tests\\": "tests/"
        }
    }
}
